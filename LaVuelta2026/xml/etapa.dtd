

<!ELEMENT etapa (nombre, numero, longitud, fecha, tiempo_ganador, velocidad_media, desnivel, ciudad_inicio, ciudad_fin, tipo, referencias, fotografias, videos, sonidos, salida, meta, hitos, puntos_anonimos, clasificacion_etapa, clasificacion_general, clasificacion_equipos)>

<!-- Datos básicos -->
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT numero (#PCDATA)>
<!ELEMENT longitud (#PCDATA)>
<!ATTLIST longitud unidad CDATA #REQUIRED>
<!ELEMENT fecha (#PCDATA)>
<!ELEMENT tiempo_ganador (#PCDATA)>
<!ELEMENT velocidad_media (#PCDATA)>
<!ATTLIST velocidad_media unidad CDATA #REQUIRED>
<!ELEMENT desnivel (#PCDATA)>
<!ATTLIST desnivel unidad CDATA #REQUIRED>
<!ELEMENT ciudad_inicio (#PCDATA)>
<!ELEMENT ciudad_fin (#PCDATA)>
<!ELEMENT tipo (#PCDATA)>

<!-- Referencias y Multimedia -->
<!ELEMENT referencias (referencia, referencia, referencia+)>
<!ELEMENT referencia (#PCDATA)>
<!ELEMENT fotografias (fotografia+)>
<!ELEMENT fotografia (#PCDATA)>
<!ELEMENT videos (video+)>
<!ELEMENT video (#PCDATA)>
<!ELEMENT sonidos (sonido+)>
<!ELEMENT sonido (#PCDATA)>

<!-- Coordenadas -->
<!ELEMENT salida (coordenadas)>
<!ELEMENT meta (coordenadas)>
<!ELEMENT coordenadas (longitud_geo, latitud_geo, altitud)>
<!ELEMENT longitud_geo (#PCDATA)>
<!ATTLIST longitud_geo unidad CDATA #REQUIRED>
<!ELEMENT latitud_geo (#PCDATA)>
<!ATTLIST latitud_geo unidad CDATA #REQUIRED>
<!ELEMENT altitud (#PCDATA)>
<!ATTLIST altitud unidad CDATA #REQUIRED>

<!-- Hitos y Puntos Anonimos -->
<!ELEMENT hitos (puerto_montana | sprint)*>
<!ELEMENT puerto_montana (coordenadas, distancia)>
<!ATTLIST puerto_montana tipo (primera|segunda|tercera|especial|bonificado) #REQUIRED>
<!ELEMENT sprint (coordenadas, distancia)>
<!ATTLIST sprint tipo (intermedio|bonificado) #REQUIRED>
<!ELEMENT distancia (#PCDATA)>
<!ATTLIST distancia unidad CDATA #REQUIRED>

<!ELEMENT puntos_anonimos (punto_anonimo*)>
<!ELEMENT punto_anonimo (nombre_punto?, coordenadas, distancia)>
<!ELEMENT nombre_punto (#PCDATA)>

<!-- Clasificaciones -->
<!ELEMENT clasificacion_etapa (clasificado, clasificado, clasificado)>
<!ELEMENT clasificacion_general (clasificado, clasificado, clasificado)>
<!ELEMENT clasificacion_equipos (equipo, equipo, equipo)>

<!ELEMENT clasificado (posicion, corredor, diferencia_tiempo?)>
<!ELEMENT equipo (posicion, nombre_equipo, diferencia_tiempo?)>
<!ELEMENT posicion (#PCDATA)>
<!ELEMENT corredor (#PCDATA)>
<!ELEMENT nombre_equipo (#PCDATA)>
<!ELEMENT diferencia_tiempo (#PCDATA)>
